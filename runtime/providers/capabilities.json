{
  "_about": "Capability-based Runtime Provider Interface (RPI) matrix for open-fleet (#586). Declares the 8 runtime capabilities, the 14 orchestrator providers (native vs portable fallback capabilities and supported coding-agent harnesses), and the per-mission required/optional capability contract enforced by runtime/scripts/preflight.py.",
  "schema_version": "open-fleet-capabilities/v1",
  "capabilities": {
    "cap:core-orchestration": {
      "description": "Worktree isolation, task/run state, worker lifecycle (spawn/fence/poll), and two-way mailbox messaging.",
      "fallback": "runtime/providers/local_state.py (SQLite WAL + git worktree + tmux/nohup)"
    },
    "cap:sandbox-vm": {
      "description": "Disposable VM or container isolation for untrusted code execution and environment recipe verification.",
      "fallback": "runtime/scripts/sandbox_doctor.py (Docker, Podman, bwrap, Gondolin, E2B, Daytona, Modal, Fly, Sprites)"
    },
    "cap:session-search": {
      "description": "Cross-session FTS5 transcript indexing and search for prior-art recall and compound learning.",
      "fallback": "runtime/scripts/search_sessions.py (10-harness local JSONL/SQLite indexer)"
    },
    "cap:browser": {
      "description": "Headless browser automation, DOM snapshot, console/network capture, and Core Web Vitals/a11y probing.",
      "fallback": "Playwright CLI / Chrome DevTools MCP / agent-browser"
    },
    "cap:mobile-emulator": {
      "description": "iOS Simulator and Android Emulator lifecycle, screenshot, UI hierarchy dump, and gesture injection.",
      "fallback": "xcrun simctl (macOS) and Android adb"
    },
    "cap:issue-tracker": {
      "description": "Issue and pull-request enumeration, creation, commenting, and state transitions.",
      "fallback": "GitHub CLI (gh) and runtime/scripts/pm.py"
    },
    "cap:scheduler": {
      "description": "Recurring cron/interval execution for unattended sweeps and sentinel missions.",
      "fallback": "POSIX crontab / systemd-run / GitHub Actions schedule"
    },
    "cap:orca-self-audit": {
      "description": "Live inspection of the proprietary stablyai/orca binary and `orca skills get` embedded skill bundle.",
      "fallback": null
    }
  },
